{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolidTool",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "discontinued",
        "unknown"
      ]
    },
    "diameter": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "flute_count": {
      "type": "integer",
      "minimum": 1
    },
    "helix_angle": {
      "type": "number",
      "minimum": 0,
      "maximum": 90
    }
  },
  "required": [
    "id",
    "name",
    "model",
    "status"
  ]
}
