@prefix ct: <https://example.org/cutting-tool/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ct:CatalogCategoryShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ] ;
    sh:targetClass ct:CatalogCategory .

ct:CoatingProcessShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ] ;
    sh:targetClass ct:CoatingProcess .

ct:CuttingConditionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path ct:hardnessMin ],
        [ sh:datatype xsd:string ;
            sh:in ( "HB" "HRC" "HV" ) ;
            sh:maxCount 1 ;
            sh:path ct:hardnessScale ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:string ;
            sh:in ( "continuous" "interrupted" "mixed" "unknown" ) ;
            sh:maxCount 1 ;
            sh:path ct:cuttingMode ],
        [ sh:datatype xsd:string ;
            sh:in ( "dry" "wet" "mql" "unknown" ) ;
            sh:maxCount 1 ;
            sh:path ct:coolantMode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path ct:hardnessMax ] ;
    sh:targetClass ct:CuttingCondition .

ct:CuttingParamShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0 ;
            sh:path ct:vcMax ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ct:apUnit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0 ;
            sh:path ct:feedMax ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path ct:apMax ],
        [ sh:datatype xsd:string ;
            sh:in ( "fn" "fz" "vf" ) ;
            sh:maxCount 1 ;
            sh:path ct:feedType ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0 ;
            sh:path ct:feedMin ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0 ;
            sh:path ct:vcRecommended ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0 ;
            sh:path ct:vcMin ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path ct:apMin ],
        [ sh:datatype xsd:string ;
            sh:in ( "mm/rev" "mm/tooth" "mm/min" ) ;
            sh:maxCount 1 ;
            sh:path ct:feedUnit ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path ct:vcUnit ] ;
    sh:targetClass ct:CuttingParam .

ct:CuttingRecommendationShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "tool" "series" "grade" "series_grade" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:scopeType ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:string ;
            sh:in ( "draft" "reviewed" "approved" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ] ;
    sh:targetClass ct:CuttingRecommendation .

ct:EntityShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ] ;
    sh:targetClass ct:Entity .

ct:HolderShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0 ;
            sh:path ct:length ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ],
        [ sh:datatype xsd:string ;
            sh:in ( "active" "inactive" "discontinued" "unknown" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minLength 1 ;
            sh:path ct:shankSize ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 120 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:model ] ;
    sh:targetClass ct:Holder .

ct:InsertShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0 ;
            sh:path ct:ic ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 120 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:model ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0 ;
            sh:path ct:thickness ],
        [ sh:datatype xsd:string ;
            sh:in ( "active" "inactive" "discontinued" "unknown" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:status ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 180 ;
            sh:minExclusive 0 ;
            sh:path ct:tipAngle ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path ct:cornerRadius ] ;
    sh:targetClass ct:Insert .

ct:InsertSpecificationShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
