ct:MaterialClassShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
