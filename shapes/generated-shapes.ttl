ct:WorkpieceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "HB" "HRC" "HV" ) ;
            sh:maxCount 1 ;
            sh:path ct:hardnessScale ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path ct:hardnessValue ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
