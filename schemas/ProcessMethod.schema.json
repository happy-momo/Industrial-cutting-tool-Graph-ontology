{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcessMethod",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "concept_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^https://example\\.org/cutting-tool/vocabulary/(tool|process|material)#[A-Za-z][A-Za-z0-9_-]*$"
    }
  },
  "required": [
    "id",
    "name",
    "concept_ref"
  ]
}
