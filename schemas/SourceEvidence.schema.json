{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceEvidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "page_number": {
      "type": "integer",
      "minimum": 1
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name",
    "source_locator"
  ]
}
