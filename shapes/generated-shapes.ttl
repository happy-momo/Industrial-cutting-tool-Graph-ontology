ct:SourceEvidenceShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path ct:pageNumber ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:sourceLocator ] ;
    sh:targetClass ct:SourceEvidence .

