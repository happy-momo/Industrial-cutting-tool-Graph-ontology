ct:SolidToolShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 90 ;
            sh:minInclusive 0 ;
            sh:path ct:helixAngle ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0 ;
            sh:path ct:diameter ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:string ;
            sh:in ( "active" "inactive" "discontinued" "unknown" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path ct:fluteCount ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 120 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:model ] ;
    sh:targetClass ct:SolidTool .

ct:SourceDocumentShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 240 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:documentName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:documentVersion ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
