ct:ToolShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "active" "inactive" "discontinued" "unknown" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 120 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path ct:model ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path ct:id ;
            sh:pattern "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$" ],
